<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_immersive_background"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Carátula del Álbum (Cuadrada a la izquierda) -->
    <ImageView
        android:id="@+id/widget_compact_cover_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Controles Multimedia y Favorito (Alineados a la derecha) -->
    <LinearLayout
        android:id="@+id/widget_compact_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Botón Me Gusta (Favorito) -->
        <ImageButton
            android:id="@+id/widget_compact_btn_like"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_heart_outline"
            android:scaleType="centerInside"
            android:contentDescription="@null" />

        <!-- Botón Anterior -->
        <ImageButton
            android:id="@+id/widget_compact_btn_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_skip_previous"
            android:scaleType="centerInside"
            android:contentDescription="@null" />

        <!-- Botón Reproducir / Pausa -->
        <ImageButton
            android:id="@+id/widget_compact_btn_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside"
            android:contentDescription="@null" />

        <!-- Botón Siguiente -->
        <ImageButton
            android:id="@+id/widget_compact_btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_skip_next"
            android:scaleType="centerInside"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Metadatos (Título y Artista entre la carátula y los controles) -->
    <LinearLayout
        android:id="@+id/widget_compact_metadata_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_compact_cover_image"
        android:layout_toStartOf="@id/widget_compact_controls_container"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orpheus"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_compact_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Escucha algo grandioso"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
